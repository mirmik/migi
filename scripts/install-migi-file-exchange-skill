#!/bin/sh
set -eu

migi_installer_path=$(readlink -f "$0")
migi_repo_root=$(cd "$(dirname "$migi_installer_path")/.." && pwd -P)
migi_skill_parent="${MIGI_SKILL_HOME:-$HOME/.agents/skills}"

mkdir -p "$migi_skill_parent"

for migi_skill_name in migi-file-exchange migi-android-publisher migi-audio-player; do
	migi_skill_source="$migi_repo_root/skills/$migi_skill_name"
	migi_skill_target="$migi_skill_parent/$migi_skill_name"

	if [ ! -f "$migi_skill_source/SKILL.md" ]; then
		echo "Migi skill source is missing: $migi_skill_source" >&2
		exit 1
	fi

	if [ -e "$migi_skill_target" ]; then
		echo "Refusing to replace an existing path: $migi_skill_target" >&2
		exit 1
	fi

	migi_skill_stage=$(mktemp -d "$migi_skill_parent/.migi-skill-$migi_skill_name.XXXXXX")
	if ! cp -R "$migi_skill_source/." "$migi_skill_stage/"; then
		echo "Failed to stage Migi skill; partial copy left at $migi_skill_stage" >&2
		exit 1
	fi
	if ! mv -T "$migi_skill_stage" "$migi_skill_target"; then
		echo "Failed to install Migi skill; staged copy left at $migi_skill_stage" >&2
		exit 1
	fi
	echo "Installed self-contained Migi skill: $migi_skill_target"
done
