#!/usr/bin/env python3
"""Index or queue a naturally ordered album with the bundled migi-play client."""

from __future__ import annotations

import argparse
import os
import re
import sys
from pathlib import Path


AUDIO_SUFFIXES = {
    ".mp3",
    ".opus",
    ".ogg",
    ".oga",
    ".flac",
    ".m4a",
    ".mp4",
    ".aac",
    ".wav",
}
ARTWORK_SUFFIXES = {".jpg", ".jpeg", ".png", ".webp"}


def version_key(path: Path) -> tuple:
    return tuple(
        (0, int(part)) if part.isdigit() else (1, part.casefold())
        for part in re.split(r"(\d+)", path.name)
    )


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(prog="migi-album")
    result.add_argument("--name", default="", help="playlist name")
    result.add_argument("--device", default="", help="paired device ID")
    result.add_argument("--source", default="codex", help="source label")
    result.add_argument("--config", default=None, help="agent JSON configuration")
    result.add_argument("--endpoint", default=None, help="trusted local HTTP endpoint")
    result.add_argument(
        "--lazy",
        action="store_true",
        help="register this machine as the media origin and transfer tracks on demand",
    )
    result.add_argument(
        "--index-only",
        action="store_true",
        help="add the album to the remote catalog without publishing a playback queue",
    )
    cover = result.add_mutually_exclusive_group()
    cover.add_argument("--cover", default="", help="explicit JPEG, PNG, or WebP artwork")
    cover.add_argument("--no-cover", action="store_true", help="do not attach artwork")
    result.add_argument("directory", type=Path)
    return result


def auto_cover(directory: Path) -> Path | None:
    files = [item for item in directory.iterdir() if item.is_file()]
    for stem in ("cover", "folder", "front"):
        matches = sorted(
            (
                item
                for item in files
                if item.stem.casefold() == stem and item.suffix.casefold() in ARTWORK_SUFFIXES
            ),
            key=lambda item: item.name.casefold(),
        )
        if matches:
            return matches[0]
    return None


def run(argv: list[str] | None = None) -> int:
    args = parser().parse_args(argv)
    if args.config is not None and args.endpoint is not None:
        raise ValueError("--config and --endpoint cannot be used together")
    directory = args.directory.resolve()
    if not directory.is_dir():
        raise ValueError(f"not a directory: {directory}")
    tracks = sorted(
        (
            item
            for item in directory.iterdir()
            if item.is_file() and item.suffix.casefold() in AUDIO_SUFFIXES
        ),
        key=version_key,
    )
    if not tracks:
        raise ValueError("no supported audio files found")
    if len(tracks) > 32:
        raise ValueError("album has more than 32 tracks")

    cover: Path | None = None
    if args.cover:
        cover = Path(args.cover).resolve()
        if not cover.is_file():
            raise ValueError(f"cover is not a file: {cover}")
        if cover.suffix.casefold() not in ARTWORK_SUFFIXES:
            raise ValueError("cover must be JPEG, PNG, or WebP")
    elif not args.no_cover:
        cover = auto_cover(directory)

    name = args.name or directory.name
    play = Path(__file__).resolve().with_name("migi-play")
    command = [sys.executable, str(play), "-name", name, "-source", args.source]
    if args.config is not None:
        command.extend(("-config", args.config))
    if args.endpoint is not None:
        command.extend(("-endpoint", args.endpoint))
    if args.device:
        command.extend(("-device", args.device))
    if args.lazy and not args.index_only:
        command.append("--lazy")
    if cover is not None:
        command.extend(("-cover", str(cover)))
    command.append("index" if args.index_only else "play")
    command.extend(str(track) for track in tracks)

    action = "Indexing" if args.index_only else "Queueing"
    print(f"{action} {len(tracks)} tracks as {name}", file=sys.stderr)
    if cover is not None:
        print(f"  artwork: {cover}", file=sys.stderr)
    for track in tracks:
        print(f"  {track}", file=sys.stderr)
    os.execv(sys.executable, command)
    return 0


def main() -> int:
    try:
        return run()
    except (OSError, ValueError) as exc:
        print(f"migi-album: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
